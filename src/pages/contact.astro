---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="How to reach the Hinman Lab at UCLA.">
  <section class="border-b border-[color:var(--color-rule)]">
    <div class="mx-auto max-w-4xl px-5 py-16 sm:px-8 sm:py-20">
      <p class="text-xs uppercase tracking-[0.22em] text-[color:var(--color-faint)]">Contact</p>
      <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Get in touch</h1>
      <p class="mt-4 max-w-2xl text-[color:var(--color-muted)]">
        For questions about ongoing research, publications, data sharing, collaborations, or open
        positions in the lab.
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-4xl px-5 py-12 sm:px-8 sm:py-16">
      <div class="grid grid-cols-1 gap-12 sm:grid-cols-2">
        <div>
          <h2 class="font-serif text-xl tracking-tight">Lab</h2>
          <address class="mt-3 not-italic text-sm leading-relaxed text-[color:var(--color-muted)]">
            The Hinman Lab<br />
            Department of Neurology<br />
            David Geffen School of Medicine at UCLA<br />
            710 Westwood Plaza<br />
            Los Angeles, CA 90095
          </address>
          <p class="mt-4 text-sm text-[color:var(--color-muted)]">
            Phone: <a href="tel:310-825-7802" class="no-underline">310-825-7802</a>
          </p>
        </div>

        <div>
          <h2 class="font-serif text-xl tracking-tight">Online</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <a href="https://www.uclahealth.org/providers/jason-hinman" class="no-underline" rel="external noopener">
                UCLA Health profile
              </a>
            </li>
            <li>
              <a href="https://profiles.ucla.edu/jason.hinman" class="no-underline" rel="external noopener">
                UCLA Profiles
              </a>
            </li>
            <li>
              <a href="https://orcid.org/0000-0002-0872-5044" class="no-underline" rel="external noopener">
                ORCID 0000-0002-0872-5044
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/jason-hinman-5a73a441/" class="no-underline" rel="external noopener">
                LinkedIn
              </a>
            </li>
            <li>
              <a href="https://twitter.com/HinmanLabUCLA" class="no-underline" rel="external noopener">
                X / Twitter — @HinmanLabUCLA
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-12 border-t border-[color:var(--color-rule)] pt-6">
        <h2 class="font-serif text-xl tracking-tight">Prospective trainees</h2>
        <p class="mt-2 text-sm text-[color:var(--color-muted)]">
          For postdoctoral fellowship and staff position inquiries, please send a CV, brief statement
          of research interests, and three references via email. UCLA undergraduates: please use the
          undergraduate intake form on the
          <a href="/join/" class="no-underline">Join</a> page.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
