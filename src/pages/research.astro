---
import BaseLayout from "../layouts/BaseLayout.astro";
import research from "../data/research.json";
import { getCollection } from "astro:content";

const pubsAll = await getCollection("publications");
pubsAll.sort((a, b) => b.data.year - a.data.year);
const funding = (await getCollection("funding")).sort(
  (a, b) => Number(b.data.start ?? 0) - Number(a.data.start ?? 0)
);

const pubLink = (d: any): string =>
  d.url ?? (d.doi ? `https://doi.org/${d.doi}` : d.pmid ? `https://pubmed.ncbi.nlm.nih.gov/${d.pmid}/` : "#");

// keyword sets to surface a few related papers per program (pubs carry no tags)
const keywords: Record<string, string[]> = {
  "white-matter": ["white matter", "myelin", "oligodendrocyte", "oligovascular", "axon", "sarm1", "remyelination", "stroke"],
  "vcid": ["cognit", "dementia", "alzheimer", "placental growth", "vascular contributions", "amyloid", "tau"],
  "icad": ["atherosclerot", "intracranial", "endothelial", "shear", "flow", "stent", "endovascular"],
  "biomarkers": ["biomarker", "markvcid", "plasma", "inflammat", "il-18", "lipid", "neurofilament"],
};
const relatedFor = (id: string) => {
  const ks = keywords[id] ?? [];
  return pubsAll
    .filter((p) => ks.some((k) => `${p.data.title} ${p.data.journal}`.toLowerCase().includes(k)))
    .slice(0, 3);
};
---

<BaseLayout title="Research" description={research.intro}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" style="color:var(--oxygen)">Research</span>
      <h1>From single vessels to the whole brain</h1>
      <p>{research.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {research.areas.map((a, i) => {
        const related = relatedFor(a.id);
        return (
          <div class="split" style={`margin-bottom: clamp(3rem,7vw,6rem); ${i % 2 ? "direction:rtl" : ""}`} data-reveal>
            <div style="direction:ltr">
              <span class="r-num" style="font-size:1.1rem; color:var(--venous-soft)">Program 0{i + 1}</span>
              <h2 style="margin:.6rem 0 .4rem">{a.title}</h2>
              <div class="r-tagline" style="font-size:1.05rem">{a.tagline}</div>
              <p style="margin-top:1.1rem; font-size:1.08rem">{a.description}</p>
              <ul class="r-highlights" style="margin-top:1.4rem">
                {a.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </div>
            <div style="direction:ltr">
              <div class="r-card" style="background:var(--bg-soft)">
                <span class="eyebrow">Related publications</span>
                <ul style="margin-top:1rem; display:grid; gap:.9rem">
                  {related.length ? related.map((p) => (
                    <li class="pub" style="padding:.6rem 0; border:0">
                      <span class="bullet"></span>
                      <div>
                        <h3 style="font-size:.98rem"><a href={pubLink(p.data)} target="_blank" rel="noopener">{p.data.title}</a></h3>
                        <div class="meta"><span class="jrnl">{p.data.journal}</span> · {p.data.year}</div>
                      </div>
                    </li>
                  )) : <li><p style="font-size:.95rem">See the publications page for related work.</p></li>}
                </ul>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Support</span>
        <h2>Funding</h2>
        <p>Our work is made possible by the generous support of public and private funders.</p>
      </div>
      <div class="join-grid">
        {funding.map((g, i) => (
          <article class="join-card" data-reveal data-delay={i % 3}>
            <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem">
              <span class="r-num" style="color:var(--venous-soft); font-size:.85rem">{g.data.grant}</span>
              {g.data.active && <span class="tag" style="background:rgba(34,211,238,.15); color:var(--oxygen)">Active</span>}
            </div>
            <h3 style="font-size:1.1rem; margin-top:.6rem">
              {g.data.url ? <a href={g.data.url} target="_blank" rel="noopener" style="color:var(--ink)">{g.data.title}</a> : g.data.title}
            </h3>
            <p style="margin-top:.5rem; font-size:.95rem">
              {g.data.agency}{g.data.role ? ` · ${g.data.role}` : ""}{g.data.start ? ` · since ${g.data.start}` : ""}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-ink">
    <div class="container" style="text-align:center; max-width:680px">
      <span class="eyebrow" style="color:var(--oxygen); justify-content:center" data-reveal>Our commitment</span>
      <h2 style="margin-top:.9rem" data-reveal>Equity in science and medicine</h2>
      <p style="margin-top:1rem; font-size:1.12rem" data-reveal data-delay="1">
        Across every program, we are committed to equity in education, science, and medicine —
        training the next generation of physician-scientists and ensuring the benefits of discovery
        reach the communities most affected by stroke and dementia.
      </p>
      <div style="margin-top:2rem" data-reveal data-delay="2">
        <a class="btn btn-on-ink" href="/join/">Join the lab</a>
      </div>
    </div>
  </section>
</BaseLayout>
