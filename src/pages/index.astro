---
import BaseLayout from "../layouts/BaseLayout.astro";
import VesselField from "../components/VesselField.astro";
import site from "../data/site.json";
import research from "../data/research.json";
import copy from "../data/copy.json";
import { getCollection } from "astro:content";

const team = await getCollection("team");
const pubsAll = await getCollection("publications");
const pi = team.find((m) => m.data.group === "PI")!;
const piBio = pi.body?.replace(/\s+/g, " ").trim() ?? "";
const piRoleHtml = pi.data.easton_url
  ? pi.data.role.replace(
      "UCLA Mary S. Easton Center for Alzheimer's Research & Care",
      `<a href="${pi.data.easton_url}" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-underline-offset:2px">UCLA Mary S. Easton Center for Alzheimer&#39;s Research &amp; Care</a>`
    )
  : pi.data.role;

const featured = pubsAll.filter((p) => p.data.featured).slice(0, 4);
const pubLink = (d: any): string =>
  d.url ?? (d.doi ? `https://doi.org/${d.doi}` : d.pmid ? `https://pubmed.ncbi.nlm.nih.gov/${d.pmid}/` : "#");

// live counts feed the animated stat band
const memberCount = team.filter((m) => m.data.group !== "PI").length;
const stats = research.stats.map((s) =>
  s.label.includes("publication") ? { ...s, value: pubsAll.length }
  : s.label.includes("member") ? { ...s, value: memberCount }
  : s
);
---

<BaseLayout>
  <!-- HERO -->
  <header class="hero">
    <VesselField />
    <span class="hero-glow g1"></span>
    <span class="hero-glow g2"></span>
    <div class="container">
      <div class="hero-inner">
        <span class="hero-badge"><span class="dot"></span> {site.institution}</span>
        <h1>
          {copy.home.heroHeadlineTop}<br />
          <span class="gradient-text">{copy.home.heroHeadlineAccent}</span>
        </h1>
        <p class="lead">{site.description}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/research/">
            Explore our research
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a class="btn btn-on-ink" href="/team/">Meet the lab</a>
        </div>
      </div>
    </div>
    <div class="scroll-cue"><span>Scroll</span><span class="line"></span></div>
  </header>

  <!-- STATS -->
  <section class="section-tight">
    <div class="container">
      <div class="stats" data-reveal>
        {stats.map((s) => (
          <div class="stat">
            <div class="num">
              <span data-count={s.value} data-raw={s.raw ? "true" : "false"}>0</span><span class="suffix">{s.suffix}</span>
            </div>
            <div class="lbl">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT / PI -->
  <section class="section" id="about">
    <div class="container">
      <div class="split" style="align-items:start">
        <div data-reveal>
          <span class="eyebrow">{copy.home.aboutEyebrow}</span>
          <h2>{copy.home.aboutHeading}</h2>
          {copy.home.aboutParagraphs.map((para, i) => (
            <p class={i === 0 ? "lead-block" : ""} style={i === 0 ? "margin-top:1.2rem" : "margin-top:1rem"}>{para}</p>
          ))}
          <div class="hero-cta" style="margin-top:1.8rem">
            <a class="btn btn-ghost" href="/research/">Our research programs</a>
          </div>
        </div>
        <div data-reveal data-delay="1">
          <div style="display:flex; gap:1.2rem; align-items:flex-start">
            <img
              class="portrait"
              src={pi.data.photo}
              alt={pi.data.name}
              loading="lazy"
              width="150"
              height="180"
              style="width:150px; flex:none; aspect-ratio:5/6; border-radius:var(--radius-sm)"
            />
            <div>
              <span class="eyebrow">Principal Investigator</span>
              <h3 style="margin-top:.5rem; font-size:1.4rem">{pi.data.name}</h3>
              <div class="r-tagline" style="font-size:.9rem; line-height:1.4; color:var(--text-soft)" set:html={piRoleHtml}></div>
            </div>
          </div>
          <p style="margin-top:1.2rem">{piBio}</p>
          <div style="display:flex; gap:.6rem; margin-top:1.3rem; flex-wrap:wrap">
            {pi.data.linkedin && <a class="btn btn-ghost" style="padding:.5rem 1rem" href={pi.data.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
            {pi.data.twitter && <a class="btn btn-ghost" style="padding:.5rem 1rem" href={pi.data.twitter} target="_blank" rel="noopener">Twitter / X</a>}
            {pi.data.orcid && <a class="btn btn-ghost" style="padding:.5rem 1rem" href={`https://orcid.org/${pi.data.orcid}`} target="_blank" rel="noopener">ORCID</a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- RESEARCH PREVIEW -->
  <section class="section bg-soft" id="research">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{copy.home.researchPreviewEyebrow}</span>
        <h2>{copy.home.researchPreviewHeading}</h2>
        <p>{research.intro}</p>
      </div>
      <div class="research-grid">
        {research.areas.map((a, i) => (
          <article class="r-card" data-reveal data-delay={(i % 2) + 1}>
            <span class="r-num">0{i + 1}</span>
            <h3>{a.title}</h3>
            <div class="r-tagline">{a.tagline}</div>
            <p>{a.description}</p>
            <ul class="r-highlights">
              {a.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED PUBLICATIONS -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{copy.home.highlightsEyebrow}</span>
        <h2>{copy.home.highlightsHeading}</h2>
        <p>{copy.home.highlightsText}</p>
      </div>
      <div class="pub-featured">
        {featured.map((p, i) => (
          <a class="pub-feat-card" href={pubLink(p.data)} target="_blank" rel="noopener" data-reveal data-delay={i % 3}>
            <span class="yr">{p.data.year}</span>
            <div class="jrnl">{p.data.journal}</div>
            <h3>{p.data.title}</h3>
            <div class="auth">{p.data.authors}</div>
          </a>
        ))}
      </div>
      <div data-reveal>
        <a class="btn btn-ghost" href="/publications/">
          View all publications
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section" id="contact">
    <div class="container">
      <div class="contact-card" data-reveal>
        <div class="split" style="align-items:center">
          <div>
            <span class="eyebrow" style="color:var(--oxygen)">{copy.home.contactEyebrow}</span>
            <h2 style="margin-top:.8rem">{copy.home.contactHeading}</h2>
            <p style="color:#aab6d6; margin-top:1rem; font-size:1.1rem">{copy.home.contactText}</p>
            <div class="hero-cta" style="margin-top:1.8rem">
              <a class="btn btn-primary" href={`mailto:${site.contact.email}`}>Email the lab</a>
              <a class="btn btn-on-ink" href="/join/">Open positions</a>
            </div>
          </div>
          <div class="contact-rows">
            <div class="contact-row">
              <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4zM4 7l8 6 8-6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <div><div class="lbl">Email</div><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></div>
            </div>
            <div class="contact-row">
              <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <div><div class="lbl">Phone</div><a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a></div>
            </div>
            <div class="contact-row">
              <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.5"/></svg></span>
              <div><div class="lbl">Location</div><span class="val">{site.contact.address}</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
