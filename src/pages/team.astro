---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const all = await getCollection("team");
const bio = (entry: any) => entry.body?.replace(/\s+/g, " ").trim() ?? "";

const pi = all.find((m) => m.data.group === "PI")!;

// display order of groups (PI shown separately)
const groupOrder = ["Project Scientist", "Postdoc", "Grad Student", "Clinical", "Staff", "Undergraduate", "Alumni"];
const groupLabel: Record<string, string> = {
  "Project Scientist": "Project Scientists",
  "Postdoc": "Postdoctoral Fellows",
  "Grad Student": "Graduate Students",
  "Clinical": "Clinical Research",
  "Staff": "Research Staff",
  "Undergraduate": "Undergraduate Researchers",
  "Alumni": "Alumni",
};

const others = all
  .filter((m) => m.data.group !== "PI")
  .sort((a, b) => {
    const g = groupOrder.indexOf(a.data.group) - groupOrder.indexOf(b.data.group);
    return g !== 0 ? g : (a.data.order ?? 100) - (b.data.order ?? 100);
  });

const presentGroups = groupOrder.filter((g) => others.some((m) => m.data.group === g));

// deterministic gradient avatars for members without a photo
const palettes = [
  ["#e11d48", "#fb7185"], ["#4f46e5", "#818cf8"], ["#0891b2", "#22d3ee"],
  ["#7c3aed", "#a78bfa"], ["#db2777", "#f472b6"], ["#2563eb", "#60a5fa"],
];
const initials = (name: string) =>
  name.replace(/["'].*?["']/g, " ").replace(/,.*$/, "").trim()
    .split(/\s+/).filter((w) => /[A-Za-z]/.test(w[0])).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
const paletteFor = (name: string) => {
  let h = 0;
  for (const c of name) h = (h + c.charCodeAt(0)) % palettes.length;
  return palettes[h];
};
---

<BaseLayout title="Team" description="Meet the people of the Hinman Lab.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" style="color:var(--oxygen)">Our People</span>
      <h1>Meet the lab</h1>
      <p>
        A multidisciplinary team of scientists, physicians, and trainees working together on the
        vascular biology of stroke and dementia.
      </p>
    </div>
  </section>

  <!-- PI feature -->
  <section class="section-tight" style="padding-top:clamp(3rem,6vw,5rem)">
    <div class="container">
      <div class="split pi-feature" data-reveal>
        <div class="portrait-wrap" style="max-width:380px">
          <img class="portrait" src={pi.data.photo} alt={pi.data.name} width="500" height="640" />
          <div class="portrait-tag"><strong>{pi.data.name}</strong><span>{pi.data.role}</span></div>
        </div>
        <div>
          <span class="eyebrow">Principal Investigator</span>
          <h2 style="margin-top:.8rem">{pi.data.name}</h2>
          <div class="r-tagline" style="font-size:1.02rem; line-height:1.4">{pi.data.role}</div>
          <p style="margin-top:1.1rem; font-size:1.08rem">{bio(pi)}</p>
          <div class="social" style="display:flex; gap:.6rem; margin-top:1.3rem">
            {pi.data.linkedin && <a class="btn btn-ghost" style="padding:.5rem 1rem" href={pi.data.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
            {pi.data.twitter && <a class="btn btn-ghost" style="padding:.5rem 1rem" href={pi.data.twitter} target="_blank" rel="noopener">Twitter / X</a>}
            {pi.data.orcid && <a class="btn btn-ghost" style="padding:.5rem 1rem" href={`https://orcid.org/${pi.data.orcid}`} target="_blank" rel="noopener">ORCID</a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team grid -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="team-filters" data-reveal>
        <button class="active" data-filter="all">All</button>
        {presentGroups.map((g) => <button data-filter={g}>{groupLabel[g]}</button>)}
      </div>

      <div class="team-grid" id="teamGrid">
        {others.map((m, i) => {
          const [c1, c2] = paletteFor(m.data.name);
          return (
            <article class="member" data-group={m.data.group} data-reveal data-delay={i % 3}>
              {m.data.photo ? (
                <img class="avatar" src={m.data.photo} alt={m.data.name} loading="lazy" width="112" height="112" />
              ) : (
                <div class="avatar-fallback" style={`background:linear-gradient(135deg, ${c1}, ${c2})`}>
                  {initials(m.data.name)}
                </div>
              )}
              <h3>{m.data.name}</h3>
              <div class="role">{m.data.role}</div>
              <p class="bio">{bio(m)}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".team-filters button");
    const cards = document.querySelectorAll<HTMLElement>("#teamGrid .member");
    buttons.forEach((btn) =>
      btn.addEventListener("click", () => {
        buttons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const f = btn.dataset.filter;
        cards.forEach((c) => {
          c.style.display = f === "all" || c.dataset.group === f ? "" : "none";
        });
      })
    );
  </script>
</BaseLayout>
