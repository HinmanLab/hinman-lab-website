---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const monthOrder: Record<string, number> = {
  Jan: 1, Feb: 2, Mar: 3, Apr: 4, May: 5, Jun: 6,
  Jul: 7, Aug: 8, Sep: 9, Oct: 10, Nov: 11, Dec: 12,
};

const allPubs = await getCollection('publications');
const sorted = allPubs.sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  const am = monthOrder[a.data.month ?? ''] ?? 0;
  const bm = monthOrder[b.data.month ?? ''] ?? 0;
  return bm - am;
});

const byYear: Record<number, typeof sorted> = {};
for (const pub of sorted) {
  const y = pub.data.year;
  if (!byYear[y]) byYear[y] = [] as typeof sorted;
  byYear[y].push(pub);
}
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);

function formatCitation(p: typeof sorted[number]) {
  const d = p.data;
  let parts = [d.authors, d.title.replace(/\.$/, '') + '.', `<em>${d.journal}</em>`];
  let trail = `${d.year}`;
  if (d.volume) trail += `;${d.volume}`;
  if (d.issue) trail += `(${d.issue})`;
  if (d.pages) trail += `:${d.pages}`;
  trail += '.';
  parts.push(trail);
  return parts.join(' ');
}

function highlightHinman(authors: string) {
  // Render Hinman as bold; keep the rest plain.
  return authors.replace(/Hinman J(D)?/g, (match) => `<strong>${match}</strong>`);
}
---

<BaseLayout title="Publications" description="Peer-reviewed publications from the Hinman Lab, UCLA Neurology.">
  <section class="border-b border-[color:var(--color-rule)]">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
      <p class="text-xs uppercase tracking-[0.22em] text-[color:var(--color-faint)]">Publications</p>
      <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Selected publications</h1>
      <p class="mt-4 max-w-2xl text-[color:var(--color-muted)]">
        {sorted.length} peer-reviewed publications &amp; preprints from {years[years.length - 1]}–{years[0]}.
        Author names link to PubMed; <strong>Hinman</strong> is bolded.
        For a complete list, see the
        <a href="https://www.ncbi.nlm.nih.gov/myncbi/jason.hinman.1/bibliography/public/" class="no-underline">NCBI bibliography</a>
        or
        <a href="https://orcid.org/0000-0002-0872-5044" class="no-underline">ORCID 0000-0002-0872-5044</a>.
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
      {years.map((y) => (
        <div class="mt-12 first:mt-0">
          <div class="sticky top-0 z-10 -mx-5 border-b border-[color:var(--color-rule)] bg-white/95 px-5 py-2 backdrop-blur sm:-mx-8 sm:px-8">
            <h2 class="font-serif text-xl tracking-tight">{y}</h2>
          </div>
          <ol class="mt-4 space-y-7">
            {byYear[y].map((pub) => (
              <li id={pub.id} class="text-sm leading-relaxed text-[color:var(--color-ink)]">
                <p class="text-[color:var(--color-muted)]" set:html={highlightHinman(pub.data.authors)} />
                <p class="mt-1 font-serif text-base text-[color:var(--color-ink)]">
                  {pub.data.title.replace(/\.$/, '')}.
                </p>
                <p class="mt-1 text-[color:var(--color-muted)]">
                  <em>{pub.data.journal}</em>
                  {' · '}
                  {pub.data.year}
                  {pub.data.volume && <>; {pub.data.volume}</>}
                  {pub.data.issue && <>({pub.data.issue})</>}
                  {pub.data.pages && <>:{pub.data.pages}</>}
                </p>
                <p class="mt-1 text-xs text-[color:var(--color-faint)]">
                  {pub.data.pmid && (
                    <>
                      <a
                        href={`https://pubmed.ncbi.nlm.nih.gov/${pub.data.pmid}/`}
                        class="no-underline hover:underline"
                        rel="external noopener"
                      >PMID {pub.data.pmid}</a>
                    </>
                  )}
                  {pub.data.pmcid && (
                    <>
                      {' · '}
                      <a
                        href={`https://www.ncbi.nlm.nih.gov/pmc/articles/${pub.data.pmcid}/`}
                        class="no-underline hover:underline"
                        rel="external noopener"
                      >{pub.data.pmcid}</a>
                    </>
                  )}
                  {pub.data.doi && (
                    <>
                      {' · '}
                      <a href={`https://doi.org/${pub.data.doi}`} class="no-underline hover:underline" rel="external noopener">
                        DOI {pub.data.doi}
                      </a>
                    </>
                  )}
                </p>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
