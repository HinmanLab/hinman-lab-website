---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import { getCollection } from "astro:content";

const all = await getCollection("publications");
// newest first
all.sort((a, b) => b.data.year - a.data.year);

const pubLink = (d: any): string | null =>
  d.url ?? (d.doi ? `https://doi.org/${d.doi}` : d.pmid ? `https://pubmed.ncbi.nlm.nih.gov/${d.pmid}/` : null);

const featured = all.filter((p) => p.data.featured);

// group by year
const byYear = new Map<number, typeof all>();
for (const p of all) {
  if (!byYear.has(p.data.year)) byYear.set(p.data.year, []);
  byYear.get(p.data.year)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const renderAuthors = (authors: string) =>
  authors.replace(/(Hinman JD)/g, '<span class="me">$1</span>');
---

<BaseLayout title="Publications" description="Peer-reviewed publications from the Hinman Lab.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" style="color:var(--oxygen)">Publications</span>
      <h1>{all.length} publications</h1>
      <p>
        Peer-reviewed work from the lab and its collaborators, kept current from PubMed. For the
        canonical list see <a href={site.social.pubmed} target="_blank" rel="noopener" style="color:#fff; text-decoration:underline">Dr. Hinman's PubMed</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {featured.length > 0 && (
        <>
          <div class="section-head" data-reveal>
            <span class="eyebrow">Highlights</span>
            <h2>Featured</h2>
          </div>
          <div class="pub-featured">
            {featured.map((p, i) => {
              const href = pubLink(p.data);
              return (
                <a class="pub-feat-card" href={href ?? "#"} target="_blank" rel="noopener" data-reveal data-delay={i % 3}>
                  <span class="yr">{p.data.year}</span>
                  <div class="jrnl">{p.data.journal}</div>
                  <h3>{p.data.title}</h3>
                  <div class="auth">{p.data.authors}</div>
                </a>
              );
            })}
          </div>
        </>
      )}

      {years.map((y) => (
        <div class="pub-year-group" data-reveal>
          <div class="pub-year-head">
            <span class="y">{y}</span>
            <span class="rule"></span>
            <span style="font-size:.85rem; color:var(--text-mut)">{byYear.get(y)!.length}</span>
          </div>
          {byYear.get(y)!.map((p) => {
            const href = pubLink(p.data);
            return (
              <article class="pub">
                <span class="bullet"></span>
                <div>
                  <h3>
                    {href ? <a href={href} target="_blank" rel="noopener">{p.data.title}</a> : p.data.title}
                  </h3>
                  <div class="auth" set:html={renderAuthors(p.data.authors)}></div>
                  <div class="meta">
                    <span class="jrnl">{p.data.journal}</span>
                    {p.data.volume && <> · {p.data.volume}{p.data.issue ? `(${p.data.issue})` : ""}{p.data.pages ? `:${p.data.pages}` : ""}</>}
                    {p.data.pmid && <> · <a href={`https://pubmed.ncbi.nlm.nih.gov/${p.data.pmid}/`} target="_blank" rel="noopener" style="color:var(--venous)">PMID {p.data.pmid}</a></>}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
