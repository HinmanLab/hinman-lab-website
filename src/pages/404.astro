---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="page-hero" style="min-height:60vh; display:flex; align-items:center">
    <div class="container" style="text-align:center">
      <span class="eyebrow" style="color:var(--oxygen); justify-content:center">404</span>
      <h1 style="margin-top:1rem">This page wandered off.</h1>
      <p style="margin:1rem auto 0; max-width:480px">
        The page you're looking for doesn't exist or has moved.
      </p>
      <div class="hero-cta" style="justify-content:center; margin-top:2rem">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-on-ink" href="/publications/">Browse publications</a>
      </div>
    </div>
  </section>
</BaseLayout>
