---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section>
    <div class="mx-auto max-w-3xl px-5 py-32 text-center sm:px-8">
      <p class="text-xs uppercase tracking-[0.22em] text-[color:var(--color-faint)]">404</p>
      <h1 class="mt-3 font-serif text-4xl tracking-tight">Page not found</h1>
      <p class="mt-4 text-[color:var(--color-muted)]">
        The page you were looking for doesn't exist. Try the
        <a href="/" class="no-underline">home page</a>,
        <a href="/publications/" class="no-underline">publications</a>, or
        <a href="/team/" class="no-underline">team directory</a>.
      </p>
    </div>
  </section>
</BaseLayout>
